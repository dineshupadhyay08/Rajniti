# # Rajniti Application Environment Variables
# # Copy this file to .env and configure with your actual values

# # Database Configuration (Required)
# # For local PostgreSQL: postgresql://user:password@localhost:5432/rajniti
# # For Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/rajniti

# # Flask Configuration
# SECRET_KEY=dev-secret-key-change-in-production
# FLASK_ENV=development
# FLASK_HOST=0.0.0.0
# FLASK_PORT=8000
# FLASK_DEBUG=True

# # Database Options
# DB_ECHO=false

# # Perplexity AI (Optional - for search features)
# # PERPLEXITY_API_KEY=your-perplexity-api-key-here

# # Google OAuth Configuration (Required for authentication)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# # Frontend URL (for OAuth redirects)
# FRONTEND_URL=http://localhost:3000




# Database (SQLite for local dev)
DATABASE_URL=sqlite:///rajniti.db

SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
FLASK_DEBUG=True

DB_ECHO=false

FRONTEND_URL=http://localhost:3000
